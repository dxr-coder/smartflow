# ========== SmartFlow 环境变量模板 ==========
# 复制为 .env 并填入真实值；.env 不入库（安全红线）
# 用法：cp .env.example .env && vim .env

# --- MySQL ---
DB_HOST=localhost
DB_USER=root
MYSQL_PASSWORD=your_mysql_password
DB_NAME=mianshi

# --- JWT ---
JWT_SECRET=your_random_64_char_secret_here

# --- LLM（小米 MiMo） ---
XIAOMI_API_KEY=your_xiaomi_api_key
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- 模型路由（默认同 LLM 配置，可分 tier 覆盖） ---
# ROUTER_FAST_MODEL=mimo-v2.5
# ROUTER_SMART_MODEL=mimo-v2.5
# ROUTER_BACKUP_MODEL=mimo-v2.5
# ROUTER_FAST_BASE_URL=
# ROUTER_FAST_API_KEY=

# --- 向量库 ---
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHROMA_PERSIST_DIR=./chroma_db

# --- 限流 ---
RATE_LIMIT_PER_MINUTE=10
DAILY_QUOTA=50

# --- Web 搜索（可选，不填则降级） ---
# TAVILY_API_KEY=

# --- 压测开关（v5 Locust 用） ---
# MOCK_LLM=1
